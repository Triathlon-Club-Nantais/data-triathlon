# URL interne du backend pour les rewrites Next (client) ET le fetch RSC (serveur)
BACKEND_URL=http://localhost:8001
# URL absolue utilisée par les Server Components (peut différer en prod)
API_URL=http://localhost:8001

# Secret partagé du cron « keep-warm » (frontend/app/api/cron/keep-warm/route.ts).
# Un cron externe (serveur Azure) appelle GET /api/cron/keep-warm toutes les ~10 min en
# envoyant l'en-tête `Authorization: Bearer $CRON_SECRET` ; la route rejette (401) sinon.
# Générer une valeur : openssl rand -hex 32.
# NE JAMAIS committer la vraie valeur ; laissée vide en local => auth du cron ignorée.
CRON_SECRET=

# Analytics produit PostHog (frontend/instrumentation-client.ts, issue #339).
# Absentes ici => init() ne se lance pas, aucun événement envoyé en local (cf.
# instrumentation-client.ts). Valeurs dans PostHog → Project settings → API keys.
# Cloud EU : token propre au projet, jamais un secret backend (NEXT_PUBLIC_*
# finit de toute façon dans le bundle client).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
