# Connexion base de données (Supabase en prod, SQLite en local par défaut)
DATABASE_URL=sqlite:///./triathlon.db

# Origines CORS autorisées (CSV). Restreindre en production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Cache TTL dynamique (secondes) — valeurs par défaut : 10 min / 30 j
# CACHE_TTL_IN_PROGRESS_SECONDS=600
# CACHE_TTL_FINISHED_SECONDS=2592000

# Observabilité SQL (#89)
# Seuil de lenteur en ms : toute requête au-delà sort en WARNING. 0 = désactivé.
# SQL_SLOW_QUERY_MS=100
# Bilan agrégé par unité de travail (requête HTTP, épreuve importée) — verbeux.
# SQL_QUERY_STATS=false

# Traçage OpenTelemetry — éteint par défaut, aucun collecteur hébergé à ce jour.
# OTEL_ENABLED=false
# OTEL_TRACES_EXPORTER=none          # none | console | otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example/v1/traces
# OTEL_SERVICE_NAME=data-triathlon-backend

# ── Authentification SSO ───────────────────────────────────────────────
# Toutes facultatives : sans elles, le site public fonctionne intégralement et
# aucun moyen de connexion n'est proposé.
# ATTENTION worktree : ce fichier est recopié par .worktreeinclude. N'y figez ni
# AUTH_REDIRECT_BASE_URL ni les identifiants OAuth.
AUTH_SESSION_SECRET_KEY=      # ≥ 32 car. sinon le démarrage échoue ; vide = non configuré
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=          # CSV. VIDE INTERDIT TOUTE CONNEXION.
AUTH_REDIRECT_BASE_URL=http://127.0.0.1:3000   # origine de l'interface, jamais de l'API
AUTH_COOKIE_SECURE=false      # true en prod (retire/pose le préfixe __Host-)
AUTH_SESSION_TTL_DAYS=7
AUTH_STATE_TTL_SECONDS=600

# ── Lancement des batches depuis /admin (#47) ──────────────────────────
# Facultatives : sans jeton, l'écran annonce que le lancement n'est pas
# configuré et rien d'autre ne change. Jeton *fine-grained*, ce dépôt seul,
# permission `actions: write` ; il expire (un an au plus).
GITHUB_BATCH_TOKEN=
# GITHUB_REPOSITORY=Triathlon-Club-Nantais/data-triathlon
# GITHUB_WORKFLOW_FILE=batch.yml
