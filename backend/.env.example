# Connexion base de données (Supabase en prod, SQLite en local par défaut)
DATABASE_URL=sqlite:///./triathlon.db

# Origines CORS autorisées (CSV). Restreindre en production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Cache TTL dynamique (secondes) — valeurs par défaut : 10 min / 30 j
# CACHE_TTL_IN_PROGRESS_SECONDS=600
# CACHE_TTL_FINISHED_SECONDS=2592000

# ── Authentification GitHub OAuth (issue #114) ───────────────────────────────
# Laisser vides désactive l'auth sans casser l'API publique — les endpoints
# /api/v1/auth/github/* renvoient alors 503 avec un message explicite.
#
# En local : créer une app OAuth GitHub personnelle sur
#   https://github.com/settings/developers → "OAuth Apps" → "New OAuth App"
#   - Homepage URL : http://localhost:3000
#   - Authorization callback URL : http://localhost:8001/api/v1/auth/github/callback
#     (adapter au port réel du backend, cf. .dev-backend.json)
# Copier le Client ID et générer un Client Secret.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Facultatif : forcer l'URL de callback (utile derrière un proxy TLS en prod).
# GITHUB_OAUTH_REDIRECT_URL=

# Clé HMAC de signature des cookies (session + state OAuth). Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Sa rotation invalide toutes les sessions en cours (kill-switch global).
SESSION_SECRET_KEY=
# Durée de vie du cookie de session, secondes. Défaut : 7 jours.
# SESSION_MAX_AGE_SECONDS=604800
# Passer à false en dev sur http://localhost, sinon le navigateur ignore le
# cookie (Secure exige HTTPS). Doit rester true en prod.
SESSION_COOKIE_SECURE=true
# URL où le callback redirige après connexion (chaîne fixe, pas un paramètre
# d'entrée : open redirect sinon).
FRONTEND_POST_LOGIN_URL=/
