# Connexion base de données (Azure PostgreSQL Flexible Server en production,
# Supabase en preview — docs/infra-azure.md — SQLite en local par défaut)
DATABASE_URL=sqlite:///./triathlon.db

# Dimensionnement du pool de connexions (#585) — dimensionné sur le plafond
# réel d'Azure B1ms en production (35 connexions utilisateur, docs/infra-azure.md) :
# 15 + 10 pour le pool applicatif, 10 de marge pour les migrations, le batch
# GitHub Actions et les connexions manuelles. Sur un quota partagé, l'augmenter
# encore est le geste qui fait tomber l'environnement voisin.
# DB_POOL_SIZE=15
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=5

# Origines CORS autorisées (CSV). Restreindre en production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Documentation interactive de l'API (#399) : /docs, /redoc, /openapi.json.
# **Fermée par défaut** — ouverte en développement et en preview, jamais en
# production. Absente ou fausse, les trois chemins répondent 404.
DOCS_ENABLED=true

# Cache TTL dynamique (secondes) — valeurs par défaut : 10 min / 30 j
# CACHE_TTL_IN_PROGRESS_SECONDS=600
# CACHE_TTL_FINISHED_SECONDS=2592000

# Observabilité SQL (#89)
# Seuil de lenteur en ms : toute requête au-delà sort en WARNING. 0 = désactivé.
# SQL_SLOW_QUERY_MS=100
# Bilan agrégé par unité de travail (requête HTTP, épreuve importée) — verbeux.
# SQL_QUERY_STATS=false

# Géocodage (Nominatim) — les deux réglages ont un défaut utilisable tel quel.
# L'agent utilisateur identifie le club : Nominatim exige un contact joignable.
# GEOCODE_USER_AGENT=TriathlonClubResults/1.0 contact@triclunantais.fr
# Intervalle minimal entre deux appels : Nominatim plafonne à 1 req/s.
# GEOCODE_MIN_INTERVAL_SECONDS=1.1

# ── Plafonds de débit par IP (#267, #395) ──────────────────────────────
# Deux sujets distincts, fenêtre glissante d'une heure de part et d'autre, et
# quatre défauts utilisables tels quels. Hors Render aucun proxy ne pose
# X-Forwarded-For : en local l'IP reste falsifiable, ces plafonds n'y
# protègent rien.
# POST /feedback (signalement public) : compte les lignes en base pour l'IP.
# FEEDBACK_RATE_LIMIT_MAX_PER_WINDOW=5
# FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=3600
# POST /scrape/event et /scrape/event/stream : seau commun, compteur en mémoire
# du process ; un import fait jusqu'à ~26 requêtes sortantes vers un hôte tiers.
# SCRAPE_RATE_LIMIT_MAX_PER_WINDOW=10
# SCRAPE_RATE_LIMIT_WINDOW_SECONDS=3600

# ── Authentification SSO ───────────────────────────────────────────────
# Toutes facultatives : sans elles, le site public fonctionne intégralement et
# aucun moyen de connexion n'est proposé.
# ATTENTION worktree : ce fichier est recopié par .worktreeinclude. N'y figez ni
# AUTH_REDIRECT_BASE_URL ni les identifiants OAuth.
AUTH_SESSION_SECRET_KEY=      # ≥ 32 car. sinon le démarrage échoue ; vide = non configuré
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# La liste des adresses autorisées vit en base (#170), plus dans une variable :
#   uv run python -m app.cli allow-email --email vous@exemple.fr
AUTH_REDIRECT_BASE_URL=http://127.0.0.1:3000   # origine de l'interface, jamais de l'API
AUTH_COOKIE_SECURE=false      # true en prod (retire/pose le préfixe __Host-)
AUTH_SESSION_TTL_DAYS=7
AUTH_STATE_TTL_SECONDS=600

# ── Mot de passe d'accès au site (#509) ────────────────────────────────
# Expiration serveur du cookie tcn_site_session, même patron que AUTH_SESSION_TTL_DAYS.
# SITE_ACCESS_SESSION_TTL_DAYS=7

# ── Lancement des batches depuis /admin (#47) ──────────────────────────
# Facultatives : sans jeton, l'écran annonce que le lancement n'est pas
# configuré et rien d'autre ne change. Jeton *fine-grained*, ce dépôt seul,
# permission `actions: write` ; il expire (un an au plus).
GITHUB_BATCH_TOKEN=
# Base que les batches de CETTE instance écrivent : preview | production.
# Propriété du déploiement, jamais un choix offert dans l'écran — sans quoi
# l'administration de la preview pourrait écrire chez les adhérents.
GITHUB_BATCH_TARGET=preview
# GITHUB_REPOSITORY=Triathlon-Club-Nantais/data-triathlon
# GITHUB_WORKFLOW_FILE=batch.yml

### POSTHOG ###
POSTHOG_PROJECT_TOKEN=